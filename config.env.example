# Ambient player settings, read by the systemd services.
# Installed to /etc/default/ambient; edit there, then:
#   sudo systemctl restart ambient-jack ambient-sc

# Sound card JACK opens. `aplay -l` lists them; use hw:<card name>.
# Until the board exists, hw:Headphones is the Pi's own headphone jack.
AMBIENT_DEVICE=hw:Headphones

# How many outputs that card has (the board: 8, headphone jack: 2).
AMBIENT_CHANNELS=2

# Optional second stereo card, such as a second USB dongle. Its two channels
# become outputs 3 and 4 (the main card is 1 and 2). Leave empty for one card.
# Two identical dongles: run tools/name-usb-cards.sh first so they keep the
# same names (ambA, ambB) whichever order they wake up in.
AMBIENT_DEVICE2=

# What the patch writes: 2 = stereo fold-down, 4 = 3 ground speakers + tree.
AMBIENT_OUTPUTS=2

# Which output (1-4) is the elevated speaker, up a tree. Birds play only there.
AMBIENT_ELEVATED=4

# Where the ambientSounds recordings are checked out. Empty = ~/ambientSounds.
AMBIENT_SOUNDS=

# JACK buffer in frames. Raise to 2048 if you hear clicks.
AMBIENT_PERIOD=1024
