[Unit]
Description=Ambient player: JACK audio server
After=sound.target

[Service]
User=@USER@
EnvironmentFile=/etc/default/ambient
Environment=JACK_NO_AUDIO_RESERVATION=1
LimitRTPRIO=95
LimitMEMLOCK=infinity
# USB dongles often start with their volume well below full. Turn them all the
# way up; the level is set in SuperCollider and on the amps.
ExecStartPre=-/bin/sh -c 'for d in "$$AMBIENT_DEVICE" "$$AMBIENT_DEVICE2"; do c=$${d#*:}; [ -n "$$c" ] || continue; for k in PCM Speaker Master; do amixer -q -c "$$c" sset "$$k" 100%% unmute 2>/dev/null; done; done; true'
ExecStart=/usr/bin/jackd -R -d alsa -P ${AMBIENT_DEVICE} -o ${AMBIENT_CHANNELS} -r 48000 -p ${AMBIENT_PERIOD} -n 3
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
